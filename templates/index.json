    "custom_liquid_9i3rBY": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section id=\"customer-reviews-section\">\n  <div class=\"cr-heading\">\n    <span class=\"cr-subtitle\">CUSTOMER FEEDBACK</span>\n    <h2>What Our Customers Say</h2>\n    <div class=\"cr-rating\">\n      <span class=\"cr-stars\">★★★★★</span>\n      <span>Loved by our customers</span>\n    </div>\n  </div>\n\n  <div class=\"cr-grid\" id=\"cr-reviews-grid\">\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Great Product Quality!</h3>\n      <p>The product looks amazing and the quality is really good. Very happy with my purchase.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">A</span>\n        <div><strong>Ahmed</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Excellent Experience</h3>\n      <p>Really nice product and a smooth shopping experience. Would recommend it.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">F</span>\n        <div><strong>Fatima</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Worth Buying</h3>\n      <p>Good-looking product with a modern design. Very easy to use.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">U</span>\n        <div><strong>Usman</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Very Nice Product</h3>\n      <p>I really like the design and the overall look of this product.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">A</span>\n        <div><strong>Ali</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Good Quality</h3>\n      <p>A beautiful product with a clean and premium appearance.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">S</span>\n        <div><strong>Sarah</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Happy With My Order</h3>\n      <p>Nice design and a pleasant shopping experience.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">H</span>\n        <div><strong>Hassan</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Really Impressive</h3>\n      <p>The product has a nice look and is simple to use.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">M</span>\n        <div><strong>Maryam</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n    <article class=\"cr-card\">\n      <div class=\"cr-stars\">★★★★★</div>\n      <h3>Great Experience</h3>\n      <p>A nice product with an attractive design.</p>\n      <div class=\"cr-customer\">\n        <span class=\"cr-avatar\">Z</span>\n        <div><strong>Zain</strong><small>Customer Review</small></div>\n      </div>\n    </article>\n\n  </div>\n\n  <div class=\"cr-button-wrap\" id=\"cr-button-wrap\">\n    <button type=\"button\" id=\"cr-toggle-button\">\n      View More Reviews\n    </button>\n  </div>\n</section>\n\n<style>\n#customer-reviews-section {\n  background: linear-gradient(180deg, #302b43 0%, #4b3770 50%, #388fce 100%);\n  padding: 38px 16px;\n  color: #ffffff;\n  font-family: inherit;\n  box-sizing: border-box;\n}\n\n#customer-reviews-section * {\n  box-sizing: border-box;\n}\n\n#customer-reviews-section .cr-heading {\n  text-align: center;\n  margin: 0 auto 28px;\n}\n\n#customer-reviews-section .cr-subtitle {\n  font-size: 11px;\n  letter-spacing: 2px;\n  font-weight: 700;\n  color: #d5c8ff;\n}\n\n#customer-reviews-section .cr-heading h2 {\n  font-size: 27px;\n  line-height: 1.3;\n  margin: 10px 0;\n  color: #ffffff;\n}\n\n#customer-reviews-section .cr-rating {\n  font-size: 13px;\n  color: #eeeeee;\n}\n\n#customer-reviews-section .cr-stars {\n  color: #ffbf47;\n  letter-spacing: 2px;\n  font-size: 17px;\n}\n\n#customer-reviews-section .cr-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n#customer-reviews-section .cr-card {\n  background: #ffffff;\n  color: #262333;\n  padding: 17px 14px;\n  border-radius: 14px;\n  border: 1px solid rgba(255,255,255,.5);\n  box-shadow: 0 5px 18px rgba(0,0,0,.12);\n  min-width: 0;\n}\n\n#customer-reviews-section .cr-card h3 {\n  font-size: 15px;\n  line-height: 1.4;\n  margin: 10px 0 7px;\n  color: #242333;\n}\n\n#customer-reviews-section .cr-card p {\n  font-size: 13px;\n  line-height: 1.65;\n  color: #666477;\n  margin: 0 0 16px;\n}\n\n#customer-reviews-section .cr-customer {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  border-top: 1px solid #eeeeF4;\n  padding-top: 12px;\n}\n\n#customer-reviews-section .cr-avatar {\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #ece5ff;\n  color: #523b91;\n  font-weight: 700;\n  flex-shrink: 0;\n}\n\n#customer-reviews-section .cr-customer strong,\n#customer-reviews-section .cr-customer small {\n  display: block;\n}\n\n#customer-reviews-section .cr-customer strong {\n  font-size: 12px;\n  color: #292637;\n}\n\n#customer-reviews-section .cr-customer small {\n  font-size: 10px;\n  color: #858294;\n  margin-top: 3px;\n}\n\n#customer-reviews-section .cr-card:nth-child(n+7) {\n  display: none;\n}\n\n#customer-reviews-section .cr-grid.cr-expanded .cr-card:nth-child(n+7) {\n  display: block;\n}\n\n#customer-reviews-section .cr-button-wrap {\n  text-align: center;\n  margin-top: 26px;\n}\n\n#customer-reviews-section #cr-toggle-button {\n  display: inline-block;\n  background: #ffffff;\n  color: #35264e;\n  border: none;\n  border-radius: 30px;\n  padding: 13px 25px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  font-family: inherit;\n}\n\n#customer-reviews-section #cr-toggle-button:hover {\n  background: #eee9ff;\n}\n\n@media screen and (min-width: 750px) {\n  #customer-reviews-section .cr-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 20px;\n  }\n\n  #customer-reviews-section {\n    padding: 50px 28px;\n  }\n}\n</style>\n\n<script>\n(function () {\n  function initCustomerReviews() {\n    var section = document.getElementById('customer-reviews-section');\n    if (!section || section.dataset.initialized === 'true') return;\n\n    var grid = section.querySelector('#cr-reviews-grid');\n    var button = section.querySelector('#cr-toggle-button');\n    var buttonWrap = section.querySelector('#cr-button-wrap');\n\n    if (!grid || !button || !buttonWrap) return;\n\n    section.dataset.initialized = 'true';\n\n    var cards = grid.querySelectorAll('.cr-card');\n\n    if (cards.length <= 6) {\n      buttonWrap.style.display = 'none';\n      return;\n    }\n\n    button.addEventListener('click', function () {\n      var expanded = grid.classList.toggle('cr-expanded');\n\n      button.textContent = expanded\n        ? 'Show Less'\n        : 'View More Reviews';\n\n      button.setAttribute('aria-expanded', String(expanded));\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initCustomerReviews);\n  } else {\n    initCustomerReviews();\n  }\n})();\n</script>",
