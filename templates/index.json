    "custom_liquid_Nmix8J": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"round-collections\">\n  {% for collection in collections %}\n    {% if collection.products_count > 0 %}\n      <a href=\"{{ collection.url }}\" class=\"round-collection-item\">\n        <div class=\"round-collection-image\">\n          {% if collection.image %}\n            <img\n              src=\"{{ collection.image | image_url: width: 200 }}\"\n              alt=\"{{ collection.title | escape }}\"\n              loading=\"lazy\"\n            >\n          {% elsif collection.products.first.featured_image %}\n            <img\n              src=\"{{ collection.products.first.featured_image | image_url: width: 200 }}\"\n              alt=\"{{ collection.title | escape }}\"\n              loading=\"lazy\"\n            >\n          {% endif %}\n        </div>\n        <span>{{ collection.title }}</span>\n      </a>\n    {% endif %}\n  {% endfor %}\n</div>\n\n<style>\n.round-collections {\n  display: flex;\n  flex-wrap: nowrap;\n  gap: 18px;\n  overflow-x: auto;\n  padding: 12px 16px 18px;\n  scrollbar-width: none;\n  -webkit-overflow-scrolling: touch;\n}\n\n.round-collections::-webkit-scrollbar {\n  display: none;\n}\n\n.round-collection-item {\n  flex: 0 0 76px;\n  width: 76px;\n  text-align: center;\n  text-decoration: none;\n  color: inherit;\n}\n\n.round-collection-image {\n  width: 76px;\n  height: 76px;\n  border-radius: 50%;\n  overflow: hidden;\n  background: #f5f5f5;\n  margin-bottom: 8px;\n}\n\n.round-collection-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n.round-collection-item span {\n  display: block;\n  font-size: 12px;\n  line-height: 1.4;\n  font-weight: 500;\n}\n</style>",
        "color_scheme": "scheme-3",
        "padding_top": 40,
        "padding_bottom": 52
      }
